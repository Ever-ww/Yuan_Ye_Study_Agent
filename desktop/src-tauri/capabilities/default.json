{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yuan Ye 本机工作台权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/yy-agent",
          "sidecar": true,
          "args": ["gateway", "start"]
        }
      ]
    }
  ]
}
